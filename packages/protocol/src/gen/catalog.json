{
  "schema": "fractonica/catalog@1",
  "protocol": 1,
  "capabilities": [
    {
      "id": 1,
      "name": "fr.button",
      "version": "1.0",
      "section": "standard",
      "summary": "Momentary push button with debounced edges and gesture recognition.",
      "doc": "`down` fires on the debounced leading edge and is the lowest-latency signal — bind game\ninput to it. `click` is semantic; with multi_press_max > 1 it waits multi_press_gap_ms\nto tell single from double clicks.\n",
      "maps_to": {
        "matter": "Switch 0x003B",
        "ha": "event, device_class: button"
      },
      "types": {
        "Gesture": {
          "click": 0,
          "double_click": 1,
          "long_press": 2,
          "press": 3,
          "release": 4
        }
      },
      "traits": [
        {
          "name": "long_press",
          "id": 1,
          "type": "bool",
          "default": true
        },
        {
          "name": "multi_press_max",
          "id": 2,
          "type": "u8",
          "default": 2,
          "range": [
            1,
            5
          ]
        }
      ],
      "config": [
        {
          "name": "debounce_ms",
          "type": "u16",
          "default": 20,
          "range": [
            0,
            200
          ],
          "unit": "ms"
        },
        {
          "name": "long_press_ms",
          "type": "u16",
          "default": 600,
          "range": [
            0,
            10000
          ],
          "unit": "ms",
          "doc": "0 disables long_press"
        },
        {
          "name": "multi_press_gap_ms",
          "type": "u16",
          "default": 250,
          "range": [
            50,
            1000
          ],
          "unit": "ms"
        },
        {
          "name": "multi_press_max",
          "type": "u8",
          "default": 2,
          "range": [
            1,
            5
          ],
          "doc": "1 = click on release, no wait"
        }
      ],
      "properties": [
        {
          "name": "pressed",
          "id": 1,
          "type": "bool"
        }
      ],
      "commands": [
        {
          "name": "inject",
          "id": 1,
          "delivery": "reliable",
          "idempotent": false,
          "visibility": "test",
          "doc": "Replays a gesture through ButtonService exactly as a real one, including `pressed`.\npress/release emit only down/up and set/clear `pressed` (hold a button for a test).\n",
          "fields": [
            {
              "name": "gesture",
              "id": 1,
              "type": "Gesture",
              "default": "click"
            }
          ],
          "examples": [
            {
              "gesture": "double_click"
            },
            {
              "gesture": "press"
            }
          ]
        }
      ],
      "events": [
        {
          "name": "down",
          "id": 1,
          "priority": "realtime",
          "fields": []
        },
        {
          "name": "up",
          "id": 2,
          "priority": "realtime",
          "fields": [
            {
              "name": "held_ms",
              "id": 1,
              "type": "duration_ms"
            }
          ]
        },
        {
          "name": "click",
          "id": 3,
          "priority": "normal",
          "fields": [
            {
              "name": "count",
              "id": 1,
              "type": "u8",
              "range": [
                1,
                5
              ]
            }
          ]
        },
        {
          "name": "long_press",
          "id": 4,
          "priority": "normal",
          "requires": {
            "trait": "long_press"
          },
          "fields": [
            {
              "name": "held_ms",
              "id": 1,
              "type": "duration_ms"
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "name": "fr.led",
      "version": "1.0",
      "section": "standard",
      "summary": "A single indicator light (mono or RGB, optionally dimmable) with on-device effects.",
      "types": {
        "ColorMode": {
          "mono": 0,
          "rgb": 1
        },
        "Effect": {
          "none": 0,
          "blink": 1
        }
      },
      "traits": [
        {
          "name": "color",
          "id": 1,
          "type": "ColorMode",
          "default": "mono"
        },
        {
          "name": "dimmable",
          "id": 2,
          "type": "bool",
          "default": false
        }
      ],
      "config": [
        {
          "name": "max_brightness",
          "type": "u8",
          "default": 255,
          "doc": "hard cap (WS2812 boards default to 64)"
        }
      ],
      "properties": [
        {
          "name": "on",
          "id": 1,
          "type": "bool"
        },
        {
          "name": "brightness",
          "id": 2,
          "type": "u8",
          "requires": {
            "trait": "dimmable"
          }
        },
        {
          "name": "color",
          "id": 3,
          "type": "rgb",
          "requires": {
            "trait": "color",
            "eq": "rgb"
          }
        }
      ],
      "commands": [
        {
          "name": "set",
          "id": 1,
          "delivery": "fast",
          "idempotent": true,
          "visibility": "public",
          "fields": [
            {
              "name": "on",
              "id": 1,
              "type": "bool"
            },
            {
              "name": "brightness",
              "id": 2,
              "type": "u8",
              "optional": true
            },
            {
              "name": "color",
              "id": 3,
              "type": "rgb",
              "optional": true
            }
          ],
          "examples": [
            {
              "on": true,
              "color": 65280
            }
          ]
        },
        {
          "name": "toggle",
          "id": 2,
          "delivery": "reliable",
          "idempotent": false,
          "visibility": "public",
          "fields": []
        },
        {
          "name": "blink",
          "id": 3,
          "delivery": "reliable",
          "idempotent": false,
          "visibility": "public",
          "doc": "Flash `count` times (0 = until stop/set), then restore the steady state and emit effect_done.",
          "fields": [
            {
              "name": "on_ms",
              "id": 1,
              "type": "u16",
              "default": 200,
              "range": [
                10,
                10000
              ],
              "unit": "ms"
            },
            {
              "name": "off_ms",
              "id": 2,
              "type": "u16",
              "default": 200,
              "range": [
                10,
                10000
              ],
              "unit": "ms"
            },
            {
              "name": "count",
              "id": 3,
              "type": "u16",
              "default": 3,
              "range": [
                0,
                1000
              ]
            },
            {
              "name": "color",
              "id": 4,
              "type": "rgb",
              "optional": true
            }
          ],
          "examples": [
            {
              "on_ms": 100,
              "off_ms": 100,
              "count": 3,
              "color": 16711680
            }
          ]
        },
        {
          "name": "stop",
          "id": 4,
          "delivery": "reliable",
          "idempotent": true,
          "visibility": "public",
          "fields": []
        }
      ],
      "events": [
        {
          "name": "effect_done",
          "id": 1,
          "priority": "normal",
          "fields": [
            {
              "name": "effect",
              "id": 1,
              "type": "Effect"
            }
          ]
        }
      ]
    },
    {
      "id": 5,
      "name": "fr.analog_in",
      "version": "0.1",
      "section": "standard",
      "summary": "An analog input sampled on the node and reported as a normalised, rate-limited value.",
      "doc": "`value` is a LATEST property (latest wins, never retried), so a fast stream never queues\nbehind itself. Use `crossed` events for thresholds that must not be missed.\n",
      "types": {
        "Filter": {
          "none": 0,
          "ema": 1,
          "median3": 2
        },
        "Direction": {
          "rising": 0,
          "falling": 1
        }
      },
      "traits": [
        {
          "name": "resolution_bits",
          "id": 1,
          "type": "u8"
        }
      ],
      "config": [
        {
          "name": "sample_hz",
          "type": "u16",
          "default": 200,
          "range": [
            1,
            1000
          ],
          "unit": "Hz"
        },
        {
          "name": "report_hz",
          "type": "u16",
          "default": 50,
          "range": [
            1,
            200
          ],
          "unit": "Hz",
          "doc": "max STATE rate"
        },
        {
          "name": "deadband",
          "type": "u16",
          "default": 64,
          "range": [
            0,
            4096
          ],
          "doc": "in normalised units/16; smaller changes are not reported"
        },
        {
          "name": "filter",
          "type": "Filter",
          "default": "ema"
        },
        {
          "name": "raw_min",
          "type": "u16",
          "default": 0
        },
        {
          "name": "raw_max",
          "type": "u16",
          "default": 4095
        },
        {
          "name": "thresholds",
          "type": "array<u16>",
          "max": 4,
          "doc": "normalised thresholds that emit `crossed`"
        }
      ],
      "properties": [
        {
          "name": "value",
          "id": 1,
          "type": "u16",
          "doc": "0..65535, after calibration and filter"
        }
      ],
      "commands": [
        {
          "name": "inject",
          "id": 1,
          "delivery": "reliable",
          "idempotent": false,
          "visibility": "test",
          "fields": [
            {
              "name": "value",
              "id": 1,
              "type": "u16"
            }
          ]
        }
      ],
      "events": [
        {
          "name": "crossed",
          "id": 1,
          "priority": "realtime",
          "fields": [
            {
              "name": "index",
              "id": 1,
              "type": "u8"
            },
            {
              "name": "direction",
              "id": 2,
              "type": "Direction"
            },
            {
              "name": "value",
              "id": 3,
              "type": "u16"
            }
          ]
        }
      ]
    },
    {
      "id": 240,
      "name": "fr.node",
      "version": "1.0",
      "section": "system",
      "summary": "System capability on port 0 of every device (instance \"node\"): identity, description, reboot, alias, bindings, state resync.",
      "types": {},
      "traits": [],
      "config": [],
      "properties": [],
      "commands": [
        {
          "name": "identify",
          "id": 1,
          "delivery": "reliable",
          "idempotent": true,
          "visibility": "public",
          "fields": [
            {
              "name": "ms",
              "id": 1,
              "type": "u16",
              "default": 3000
            }
          ]
        },
        {
          "name": "describe",
          "id": 2,
          "delivery": "reliable",
          "idempotent": true,
          "visibility": "public",
          "doc": "Returns the node descriptor (07 §7.4), encoded; HELLO descriptor_hash is FNV-1a 32 over it. BULK: TCP or serial only.",
          "fields": [],
          "result": [
            {
              "name": "descriptor",
              "id": 1,
              "type": "bytes",
              "max": 1200,
              "doc": "a protobuf-wire Descriptor (schema/protocol.yaml types)"
            }
          ]
        },
        {
          "name": "reboot",
          "id": 3,
          "delivery": "reliable",
          "idempotent": false,
          "visibility": "public",
          "fields": [
            {
              "name": "bootloader",
              "id": 1,
              "type": "bool",
              "default": false
            }
          ]
        },
        {
          "name": "set_alias",
          "id": 4,
          "delivery": "reliable",
          "idempotent": true,
          "visibility": "public",
          "fields": [
            {
              "name": "alias",
              "id": 1,
              "type": "string",
              "max": 31
            },
            {
              "name": "rev",
              "id": 2,
              "type": "u32"
            }
          ]
        },
        {
          "name": "set_groups",
          "id": 5,
          "delivery": "reliable",
          "idempotent": true,
          "visibility": "public",
          "doc": "M2",
          "fields": [
            {
              "name": "groups",
              "id": 1,
              "type": "array<u16>",
              "max": 8
            }
          ]
        },
        {
          "name": "net_set",
          "id": 6,
          "delivery": "reliable",
          "idempotent": false,
          "visibility": "public",
          "fields": [
            {
              "name": "ssid",
              "id": 1,
              "type": "string",
              "max": 32
            },
            {
              "name": "pass",
              "id": 2,
              "type": "string",
              "max": 64
            },
            {
              "name": "bssid",
              "id": 3,
              "type": "bytes",
              "max": 6,
              "optional": true
            },
            {
              "name": "hub_host",
              "id": 4,
              "type": "string",
              "max": 32,
              "optional": true
            }
          ]
        },
        {
          "name": "get_state",
          "id": 7,
          "delivery": "reliable",
          "idempotent": true,
          "visibility": "public",
          "doc": "Re-send every property with fresh LATEST seqs.",
          "fields": []
        },
        {
          "name": "bind_set",
          "id": 8,
          "delivery": "reliable",
          "idempotent": true,
          "visibility": "public",
          "doc": "Store a binding in its slot (07 §7.11), replacing what the slot held; the hub resolves and pre-encodes it.",
          "fields": [
            {
              "name": "slot",
              "id": 1,
              "type": "u8",
              "range": [
                0,
                15
              ]
            },
            {
              "name": "on_port",
              "id": 2,
              "type": "u8"
            },
            {
              "name": "on_cls",
              "id": 3,
              "type": "u8",
              "doc": "3 EVENT | 7 MSG"
            },
            {
              "name": "on_kind",
              "id": 4,
              "type": "u8",
              "doc": "the event id (EVENT)"
            },
            {
              "name": "on_topic",
              "id": 5,
              "type": "string",
              "max": 32,
              "doc": "the MSG topic (MSG)"
            },
            {
              "name": "to_mac",
              "id": 6,
              "type": "bytes",
              "max": 6
            },
            {
              "name": "to_addr",
              "id": 7,
              "type": "u16",
              "doc": "this node, another node, or 0xFFFF (MSG broadcast)"
            },
            {
              "name": "to_port",
              "id": 8,
              "type": "u8"
            },
            {
              "name": "to_cls",
              "id": 9,
              "type": "u8",
              "doc": "4 CMD | 7 MSG"
            },
            {
              "name": "to_kind",
              "id": 10,
              "type": "u8",
              "doc": "the command id (CMD)"
            },
            {
              "name": "to_topic",
              "id": 11,
              "type": "string",
              "max": 32,
              "doc": "the MSG topic (MSG)"
            },
            {
              "name": "payload",
              "id": 12,
              "type": "bytes",
              "max": 64,
              "doc": "pre-encoded CMD fields, or the MSG data"
            },
            {
              "name": "reliable",
              "id": 13,
              "type": "bool",
              "doc": "Q1: ACK_REQ, the target's RESULT or ACK, end-to-end retries"
            }
          ]
        },
        {
          "name": "bind_clear",
          "id": 9,
          "delivery": "reliable",
          "idempotent": true,
          "visibility": "public",
          "fields": [
            {
              "name": "slot",
              "id": 1,
              "type": "u8",
              "doc": "0..15, or 255: every slot"
            }
          ]
        },
        {
          "name": "bind_list",
          "id": 10,
          "delivery": "reliable",
          "idempotent": true,
          "visibility": "public",
          "doc": "Returns the stored bindings, encoded (like describe). BULK: TCP or serial only.",
          "fields": [],
          "result": [
            {
              "name": "bindings",
              "id": 1,
              "type": "bytes",
              "max": 1400,
              "doc": "a protobuf-wire BindingList (schema/protocol.yaml types)"
            }
          ]
        }
      ],
      "events": [
        {
          "name": "boot",
          "id": 1,
          "priority": "normal",
          "doc": "Sent once per boot right after the first WELCOME; exempt from the event-age rule.",
          "fields": [
            {
              "name": "reset_reason",
              "id": 1,
              "type": "u8"
            }
          ]
        },
        {
          "name": "binding_fired",
          "id": 2,
          "priority": "normal",
          "fields": [
            {
              "name": "slot",
              "id": 1,
              "type": "u8"
            },
            {
              "name": "target_status",
              "id": 2,
              "type": "u8",
              "doc": "the target's RESULT/ACK status for reliable sends; 0 for fast, MSG and broadcast; FAILED after the last attempt; BUSY with no path"
            },
            {
              "name": "rtt_us",
              "id": 3,
              "type": "u32",
              "doc": "trigger -> target RESULT; 0 for fast commands"
            },
            {
              "name": "path",
              "id": 4,
              "type": "u8",
              "doc": "0 espnow, 1 hub, 2 flood, 3 local (the node itself)"
            }
          ]
        }
      ]
    },
    {
      "id": 241,
      "name": "fr.ota",
      "version": "1.0",
      "section": "system",
      "summary": "OTA endpoint on port 240 (instance \"ota\"). Control uses cls=OTA frames (protocol.yaml), not commands.",
      "types": {},
      "traits": [],
      "config": [],
      "properties": [],
      "commands": [],
      "events": []
    },
    {
      "id": 242,
      "name": "fr.diag",
      "version": "1.0",
      "section": "system",
      "summary": "Diagnostics on port 241 (instance \"diag\"); the same command set as the serial command channel.",
      "types": {},
      "traits": [],
      "config": [],
      "properties": [],
      "commands": [
        {
          "name": "exec",
          "id": 1,
          "delivery": "reliable",
          "idempotent": false,
          "visibility": "public",
          "doc": "Runs one diag command line (info, caps, call, inject, stats, selftest, mark, log, ota, net, pin_pulse, reboot) and returns single-line JSON (BULK).",
          "fields": [
            {
              "name": "line",
              "id": 1,
              "type": "string",
              "max": 200
            }
          ],
          "result": [
            {
              "name": "json",
              "id": 1,
              "type": "string",
              "max": 1400
            }
          ]
        }
      ],
      "events": [
        {
          "name": "mark",
          "id": 1,
          "priority": "normal",
          "fields": [
            {
              "name": "token",
              "id": 1,
              "type": "string",
              "max": 32
            }
          ]
        }
      ]
    }
  ]
}
