{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fractonica:schema:fr.display.snapshot_read.args",
  "title": "fr.display.snapshot_read arguments",
  "description": "A chunk of the framebuffer of the last snapshot (BULK: TCP or serial).",
  "type": "object",
  "properties": {
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "len": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024,
      "description": "(1..1024)",
      "default": 1024
    }
  },
  "additionalProperties": false
}
