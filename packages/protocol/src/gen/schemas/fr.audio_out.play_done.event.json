{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fractonica:schema:fr.audio_out.play_done.event",
  "title": "fr.audio_out.play_done event",
  "description": "A tone or play ended: done, stopped (stop, or replaced), net_lost, underrun (the stream starved for good), error. underruns counts the silent gaps played.",
  "type": "object",
  "properties": {
    "play_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "0 for a tone"
    },
    "reason": {
      "type": "string",
      "enum": [
        "done",
        "stopped",
        "net_lost",
        "underrun",
        "error"
      ]
    },
    "underruns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "samples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "samples played"
    }
  },
  "additionalProperties": false
}
