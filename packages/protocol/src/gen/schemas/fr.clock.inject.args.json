{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fractonica:schema:fr.clock.inject.args",
  "title": "fr.clock.inject arguments",
  "description": "Holds `unix` in place of the chip for hold_ms (0 means 1,000; at most 60,000).",
  "type": "object",
  "properties": {
    "unix": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "hold_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    }
  },
  "additionalProperties": false
}
