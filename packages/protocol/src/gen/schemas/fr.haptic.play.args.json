{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fractonica:schema:fr.haptic.play.args",
  "title": "fr.haptic.play arguments",
  "description": "A pattern: steps are on, off, on, off... in ms (at most 32), played `repeat` times (default 1), replacing whatever runs. BUSY as pulse; INVALID_ARGS for no steps or an on-step above max_on_ms, and for a solenoid a zero off-step or an odd number of steps with repeat > 1.",
  "type": "object",
  "properties": {
    "steps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      },
      "description": "(<= 32 items)"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "(1..100)",
      "default": 100
    },
    "repeat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "(1..100)",
      "default": 1
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "steps": [
        100,
        80,
        100
      ]
    },
    {
      "steps": [
        40,
        40
      ],
      "level": 70,
      "repeat": 5
    }
  ]
}
