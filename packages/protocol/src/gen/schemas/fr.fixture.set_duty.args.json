{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fractonica:schema:fr.fixture.set_duty.args",
  "title": "fr.fixture.set_duty arguments",
  "description": "Sets a pwm line's LEDC duty, in 1/10,000 of full scale; RESULT when it was applied. UNSUPPORTED on any drive but pwm.",
  "type": "object",
  "properties": {
    "duty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "(0..10000)"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "duty": 5000
    },
    {
      "duty": 0
    }
  ]
}
