# GPT of the 16 GB UNO Q (ABX00162), read from a stock board with:
#   cat /sys/class/block/mmcblk0p6{7,8}/{start,size}
# qonu writes only these two partitions; the GPT and Qualcomm partitions are untouched.
SECTOR_SIZE=512
EFI_START=985408
EFI_SECTORS=1048576
ROOTFS_START=2033984
ROOTFS_SECTORS=20920568
