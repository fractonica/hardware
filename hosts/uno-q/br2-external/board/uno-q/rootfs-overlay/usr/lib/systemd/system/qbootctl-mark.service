[Unit]
Description=Mark the current A/B boot slot as successful
# Without this, Qualcomm's ABL switches slots or stops in fastboot after a few boots.
DefaultDependencies=no
Requires=boot-complete.target
After=local-fs.target boot-complete.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/qbootctl -m

[Install]
WantedBy=multi-user.target
