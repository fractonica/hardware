[Unit]
Description=qonu link daemon (STM32U585 over /dev/ttyHS1)
Documentation=file:///usr/share/doc/qonu/link.md
After=qonu-mcu-boot0.service
Wants=qonu-mcu-boot0.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/qonu-link daemon
Restart=always
RestartSec=1
RuntimeDirectory=qonu
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
