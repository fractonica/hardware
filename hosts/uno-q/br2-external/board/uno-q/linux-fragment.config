# qonu adjustments applied on top of Arduino's stock config (after localmodconfig).
CONFIG_LOCALVERSION="-qonu"
# CONFIG_LOCALVERSION_AUTO is not set
# Debian signing-key paths from the stock config do not exist here
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_COMPRESS is not set
CONFIG_MODULE_COMPRESS_NONE=y
# Smaller, faster builds: no debug info, no BTF (would need pahole)
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set

# Boot with no initramfs: everything needed to mount / is built in
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Hardware watchdog available to systemd from PID 1
CONFIG_WATCHDOG=y
CONFIG_QCOM_WDT=y

# USB gadget: NCM networking + ACM serial console on the USB-C port
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y

# USB storage on a hub: UAS for SSD enclosures (usb-storage is already built in),
# UTF-8 file names on FAT/exFAT disks
CONFIG_USB_UAS=y
CONFIG_NLS_UTF8=y

# iwd requirements (kernel crypto API from userspace, keyctl)
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# The PMIC RTC is read-only to Linux and reads 1970 at every power-up. With
# HCTOSYS, loading rtc-pm8xxx resets the clock that systemd just restored, so
# the RTC neither sets nor is set from the system clock; timesyncd owns time.
# CONFIG_RTC_HCTOSYS is not set
# CONFIG_RTC_SYSTOHC is not set

# Headless for now: no video codec (Venus firmware-name mismatch on mainline)
# CONFIG_VIDEO_QCOM_VENUS is not set
# CONFIG_VIDEO_QCOM_IRIS is not set
