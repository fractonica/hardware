# raphael: minimal headless Linux for the Raspberry Pi 3 Model B (BCM2837, 4x Cortex-A53, 1 GB).
# Boot chain: GPU boot ROM -> bootcode.bin -> start_cd.elf (reads config.txt) -> kernel8.img + device tree,
# all from the FAT partition of the SD card. No U-Boot, no initramfs.

# Architecture: 64-bit, the same CPU as the UNO Q
BR2_aarch64=y
BR2_cortex_a53=y

# Toolchain built by Buildroot (glibc is required by systemd); headers match the 6.12 kernel
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_12=y
BR2_CCACHE=y
BR2_REPRODUCIBLE=y
# The Raspberry Pi kernel's modules are xz-compressed: kmod on the Pi needs xz
BR2_PACKAGE_XZ=y

# System
BR2_INIT_SYSTEMD=y
BR2_ROOTFS_MERGED_USR=y
BR2_TARGET_GENERIC_HOSTNAME="raphael"
BR2_TARGET_GENERIC_ISSUE="raphael (Raspberry Pi 3 Model B)"
# Development setting, as on the UNO Q: an empty root password allows console login (serial
# and HDMI). SSH stays key-only. Harden before deploying anywhere.
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP=""
BR2_TARGET_TZ_INFO=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RPI3_PATH)/board/rpi3/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RPI3_PATH)/board/rpi3/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RPI3_PATH)/board/rpi3/post-image.sh"

# Kernel: Raspberry Pi's own 64-bit build (kernel8.img, 6.12 LTS) and its modules, from the firmware repository
# that rpi-firmware downloads (package/rpi-kernel-bin). Our own build of the same 6.12.61 source (GCC 15,
# bcm2711_defconfig plus a trimming fragment) never started on a Pi 3 Model B v1.2: blank HDMI, no USB. Raspberry
# Pi's build (GCC 11, their config) boots the same image.
BR2_PACKAGE_RPI_KERNEL_BIN=y

# GPU firmware: the cut-down variant, which runs with 16 MB of GPU memory (no camera or video codecs)
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI_CD=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_RPI3_PATH)/board/rpi3/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_RPI3_PATH)/board/rpi3/cmdline.txt"
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y

# systemd: networkd + resolved (mDNS) + timesyncd; nothing desktop-ish
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
# BR2_PACKAGE_SYSTEMD_HWDB is not set
# BR2_PACKAGE_SYSTEMD_PSTORE is not set
# BR2_PACKAGE_SYSTEMD_VCONSOLE is not set

# Wi-Fi (BCM43438, 2.4 GHz only) and Ethernet (SMSC LAN9514, built into the kernel)
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_IWD=y
# readline enables iwctl, for joining networks from the console
BR2_PACKAGE_READLINE=y
BR2_PACKAGE_OPENSSH=y
# BR2_PACKAGE_OPENSSH_CLIENT is not set
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_KEY_UTILS=y
BR2_PACKAGE_CA_CERTIFICATES=y

# GPIO, I2C and SPI from the shell
BR2_PACKAGE_LIBGPIOD2=y
BR2_PACKAGE_LIBGPIOD2_TOOLS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_SPI_TOOLS=y

# First boot grows the root partition to the whole card: sfdisk, partx, resize2fs
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y

# Root filesystem: ext4, grown to the rest of the SD card on first boot
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="raphael-root"
BR2_TARGET_ROOTFS_EXT2_SIZE="200M"
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit -b 4096"
# BR2_TARGET_ROOTFS_TAR is not set

# Host tools for the SD card image
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
