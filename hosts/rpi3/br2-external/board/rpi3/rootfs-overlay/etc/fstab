# <device>        <mount>  <type>  <options>                                                        <dump> <pass>
# The kernel mounts / read-only; systemd fscks it and remounts it rw.
/dev/root         /        ext4    rw,noatime                                                       0      1
# Boot partition (GPU firmware, config.txt, kernel): mounted on first access only.
/dev/mmcblk0p1    /boot    vfat    noauto,x-systemd.automount,x-systemd.idle-timeout=60,umask=0077  0      0
